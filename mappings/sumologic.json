{
  "version": "0.1.0",
  "provider": "SumoLogic/sumologic",
  "notes": "Verified mappings only. StackQL tables without an entry are skipped, not guessed.",
  "resources": [
    {
      "stackql": "collectors.collectors",
      "match": { "collector_type": "Hosted" },
      "terraform": "sumologic_collector",
      "import_id": "id",
      "fields": { "name": "name", "category": "category", "description": "description", "timezone": "time_zone" }
    },
    {
      "stackql": "collectors.collectors",
      "match": { "collector_type": "Installable" },
      "terraform": "sumologic_installed_collector",
      "import_id": "id",
      "required_inventory": ["ephemeral"],
      "fields": {
        "name": "name",
        "category": "category",
        "description": "description",
        "timezone": "time_zone",
        "ephemeral": "ephemeral",
        "host_name": "host_name"
      }
    },
    {
      "stackql": "ot_collectors.ot_collectors",
      "terraform": "sumologic_ot_collector",
      "import_id": "id",
      "fields": {
        "name": "name",
        "category": "category",
        "description": "description",
        "ephemeral": "ephemeral",
        "is_remotely_managed": "is_remotely_managed",
        "time_zone": "time_zone",
        "tags": "tags"
      }
    },
    {
      "stackql": "users.users",
      "terraform": "sumologic_user",
      "import_id": "id",
      "omit": ["transfer_to"],
      "fields": {
        "email": "email",
        "first_name": "first_name",
        "last_name": "last_name",
        "is_active": "is_active",
        "role_ids": "role_ids"
      },
      "dependencies": [
        {
          "field": "role_ids",
          "stackql": "roles.roles",
          "terraform": "sumologic_role",
          "note": "role_ids are remote IDs until role inventory is generated; emitted as literal IDs."
        }
      ]
    }
  ]
}
